# Do not copy credentials from another system. Never commit your real .env.
HUAWEI_ROUTER_USERNAME=user
HUAWEI_ROUTER_PASSWORD=
HUAWEI_ROUTER_URL=http://192.168.8.1
TARGET_NETWORK=192.168.8.0/24
# Run .venv/Scripts/python.exe tools/configure_admin.py to set the password hash.
NETGUARDIAN_ADMIN_PASSWORD_HASH=
SECRET_KEY=
# Dashboard always starts in DEMO. Use its authenticated runtime mode switch.
NETGUARDIAN_MODE=DEMO
# Legacy controlled-test CLI gates only. Normal dashboard mode switching does not need these.
# Keep them off; never enable automatic quarantine.
NETGUARDIAN_ROUTER_WRITES_ENABLED=0
NETGUARDIAN_RECOVERY_CONFIRMED=0
NETGUARDIAN_AUTHORIZED_TEST_MACS=
NETGUARDIAN_PROTECTED_MACS=
NETGUARDIAN_PROTECTED_IPS=192.168.8.1
